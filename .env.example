# Copy to .env.local and fill in. .env.local is gitignored.
#
# PREFIX RULE: NEXT_PUBLIC_* is inlined into the JavaScript sent to every
# visitor. It is a PUBLIC value. Never put an API key behind that prefix.
#
# These names must match what the code reads (src/utils/geminiApi.ts) AND what
# is configured in Vercel. A mismatch is silent: both providers fail and the
# analyzer returns randomly generated placeholder scores instead.

# --- Server-side secrets (never sent to the browser) ---

# Google AI Studio -> https://aistudio.google.com/app/apikey
# Primary provider for the resume match analyzer.
GEMINI_API_KEY=

# OpenRouter -> https://openrouter.ai/keys
# Fallback provider, tried when Gemini fails.
OPENROUTER_API_KEY=

# --- Public values (safe to expose) ---

# Canonical site origin — drives metadataBase, canonical URLs and OG images.
# No trailing slash. Defaults to the live Vercel URL if unset.
NEXT_PUBLIC_SITE_URL=https://anil-portfolio-chi.vercel.app
